# ================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# ================================================================

# --- PostgreSQL (Feast Offline Store + MLflow Backend) ---
POSTGRES_USER=recsys_user
POSTGRES_PASSWORD=recsys_password
POSTGRES_DB=recsys_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (Feast Online Store) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_USER_EVENTS=user-events

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=recsys-recommendation-engine
MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts  # or /mlflow/artifacts for local

# --- MinIO (Local S3 for MLflow artifacts) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO